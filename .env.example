# Copy to .env (never committed) or set these in your hosting dashboard (Vercel / Netlify).
# All keys are read server-side only via runtimeConfig; nothing here is exposed to the client.

# Public site URL (used for canonical / hreflang links and CORS origin)
NUXT_PUBLIC_SITE_URL=https://erieu.fr

# Resend API key (https://resend.com/api-keys)
NUXT_RESEND_API_KEY=

# Recipient of contact-form messages
NUXT_CONTACT_TO=contact@erieu.fr

# Sender address. Must be on a domain verified in Resend (e.g. no-reply@erieu.fr).
# Before the domain is verified, Resend only delivers "onboarding@resend.dev" to the account owner's address.
NUXT_CONTACT_FROM=ERIEU <onboarding@resend.dev>
